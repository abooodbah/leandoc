#include <windows.h>
#include "leandoc-version.h"

// Version resource for tools\leandoc-inspect.exe. It names the same product
// and version as LeanDoc.exe, which code signing checks before it signs.
VS_VERSION_INFO VERSIONINFO
 FILEVERSION LEANDOC_VERSION_MAJOR,LEANDOC_VERSION_MINOR,LEANDOC_VERSION_PATCH,0
 PRODUCTVERSION LEANDOC_VERSION_MAJOR,LEANDOC_VERSION_MINOR,LEANDOC_VERSION_PATCH,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Abdulfatah Bahbouh"
            VALUE "FileDescription", "LeanDoc document inspector"
            VALUE "FileVersion", LEANDOC_VERSION_STRING
            VALUE "InternalName", "leandoc-inspect"
            VALUE "LegalCopyright", "Copyright (c) 2026 Abdulfatah Bahbouh"
            VALUE "OriginalFilename", "leandoc-inspect.exe"
            VALUE "ProductName", "LeanDoc"
            VALUE "ProductVersion", LEANDOC_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
